{%- comment -%}Advent: free pickup band. Text and a button on the left, a white card of detail rows on the right. Add rows as blocks.{%- endcomment -%}
<div class="section section--padded advent-pickup-band">
  <div class="container">
    <div class="advent-pickup">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="subheading">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="advent-row-title">{{ section.settings.heading | escape }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}<a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
      </div>
      <div class="advent-pickup-card">
        {%- for block in section.blocks -%}
          <div class="advent-pickup-row" {{ block.shopify_attributes }}>
            {% render 'advent-icon', name: block.settings.icon, size: 22 %}
            <div><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Advent: pickup details",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "row", "name": "Detail row", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "calendar", "options": [
        { "value": "calendar", "label": "Calendar" }, { "value": "map", "label": "Pin" }, { "value": "mail", "label": "Email" }, { "value": "truck", "label": "Truck" }, { "value": "box", "label": "Box" }
      ] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Advent: pickup details" }]
}
{% endschema %}
