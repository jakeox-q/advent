{%- comment -%}
  Advent: players · play time · complexity row on product cards, from the bgg.* metafields.
  Each item hides when its data is missing; the whole row hides when all are missing. Rendered by snippets/product-card.liquid.
{%- endcomment -%}
{%- liquid
  assign bgg = product.metafields.bgg
  assign min_p = bgg.min_players.value
  assign max_p = bgg.max_players.value
  assign min_t = bgg.min_playtime.value
  assign max_t = bgg.max_playtime.value
  assign weight = bgg.weight.value

  comment
    RPGs show System and Category. Accessories show size or type, pack and Made for.
  endcomment
  assign line = ''
  if product.metafields.rpg.product_kind != blank or product.metafields.rpg.system != blank
    assign line = product.metafields.rpg.system.value.name
    if product.metafields.rpg.product_kind != blank
      if line != blank
        assign line = line | append: ' · '
      endif
      assign line = line | append: product.metafields.rpg.product_kind.value
    endif
  elsif product.metafields.advent.sleeve_size != blank or product.metafields.advent.related_game_names != blank
    if product.metafields.advent.sleeve_size != blank
      assign line = product.metafields.advent.sleeve_size.value
      if product.metafields.advent.pack_quantity != blank
        assign line = line | append: ' · ' | append: product.metafields.advent.pack_quantity.value | append: ' ' | append: 'advent.stats.sleeves' | t
      endif
    else
      assign line = product.type
    endif
    if product.metafields.advent.related_game_names != blank
      if line != blank
        assign line = line | append: ' · '
      endif
      assign made_for = 'advent.stats.made_for' | t
      assign line = line | append: made_for | append: ' ' | append: product.metafields.advent.related_game_names.value | join: ', '
    endif
  endif
-%}
{%- if line != blank -%}
  <div class="advent-card-stats advent-card-stats--line">{{ line | escape }}</div>
{%- elsif min_p != blank or min_t != blank or weight != blank -%}
  <div class="advent-card-stats">
    {%- if min_p != blank -%}
      <span title="{{ 'advent.stats.players' | t }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14.2a4.5 4.5 0 0 1 5 4.8"/></svg>
        {{- min_p -}}{%- if max_p != blank and max_p != min_p -%}-{{ max_p }}{%- endif -%}
      </span>
    {%- endif -%}
    {%- if min_t != blank -%}
      <span title="{{ 'advent.stats.play_time' | t }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
        {{- min_t -}}{%- if max_t != blank and max_t != min_t -%}-{{ max_t }}{%- endif %} {{ 'advent.stats.minutes' | t -}}
      </span>
    {%- endif -%}
    {%- if weight != blank -%}
      <span title="{{ 'advent.stats.complexity' | t }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 4.5a3 3 0 0 0-3 3 2.8 2.8 0 0 0-2 2.7c0 .9.4 1.6 1 2.1a2.8 2.8 0 0 0 1.2 4.6 3 3 0 0 0 5.3 1.1V5.6a3 3 0 0 0-2.5-1.1z"/><path d="M14.5 4.5a3 3 0 0 1 3 3 2.8 2.8 0 0 1 2 2.7c0 .9-.4 1.6-1 2.1a2.8 2.8 0 0 1-1.2 4.6 3 3 0 0 1-5.3 1.1V5.6a3 3 0 0 1 2.5-1.1z"/></svg>
        {{- weight | round: 1 -}}<em>/5</em>
      </span>
    {%- endif -%}
  </div>
{%- endif -%}
