{%- comment -%}
  Advent: wishlist heart, top right of the product card image. Saves to the shopper's browser (assets/advent-wishlist.js).
  Placeholder until a wishlist app is chosen. Labels: locale keys advent.wishlist.*.
{%- endcomment -%}
<script src="{{ 'advent-wishlist.js' | asset_url }}" defer="defer"></script>
<advent-wishlist class="advent-wish" data-handle="{{ product.handle }}">
  <button type="button" class="advent-wish__btn" aria-pressed="false"
          aria-label="{{ 'advent.wishlist.add' | t | escape }}"
          data-label-add="{{ 'advent.wishlist.add' | t | escape }}"
          data-label-remove="{{ 'advent.wishlist.remove' | t | escape }}">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
  </button>
</advent-wishlist>
