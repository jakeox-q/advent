{
  "sections": {
    "main": {
      "type": "main-product",
      "settings": {
        "stick_on_scroll": true,
        "select_first_variant": true,
        "sticky_atc_panel": false,
        "media_layout": "slider",
        "media_size": "default",
        "media_ratio": "1",
        "media_crop": "none",
        "enable_zoom": true,
        "zoom_mode": "hover",
        "media_arrows": "desktop",
        "show_slide_count": false,
        "media_thumbs": "desktop",
        "thumb_ratio": "1",
        "thumb_crop": "none",
        "border_color": "#e3e7ec",
        "bg_color": "#f6f8fa"
      },
      "blocks": {
        "badges": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'advent-card-badges', product: product, hide_heart: true %}"
          }
        },
        "vendor": {
          "type": "vendor-sku",
          "settings": {
            "show_vendor": true,
            "show_sku": false,
            "show_barcode": false
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "show_weight": false
          }
        },
        "bgg": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'advent-pdp-bgg', product: product %}"
          }
        },
        "expansion": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'advent-pdp-expansion', product: product %}"
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "show_tax_and_shipping": false
          }
        },
        "rrp": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'advent-pdp-rrp', product: product %}"
          }
        },
        "availability": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'advent-pdp-availability', product: product %}"
          }
        },
        "buy": {
          "type": "buy-buttons",
          "settings": {
            "show_qty_selector": true,
            "enable_dynamic_checkout": false,
            "show_pickup_availability": false,
            "show_gift_card_recipient": true
          }
        },
        "notify": {
          "type": "product-signup",
          "settings": {
            "unavailable_only": true,
            "heading": "",
            "text": "",
            "divider": false
          }
        },
        "stats": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'advent-pdp-stats', product: product %}"
          }
        },
        "tags": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'advent-pdp-tags', product: product %}"
          }
        },
        "complementary": {
          "type": "complementary",
          "settings": {
            "heading": "You might also need...",
            "products_to_show": 5,
            "layout": "slider"
          }
        },
        "delivery": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'advent-pdp-delivery' %}"
          }
        },
        "jumps": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{% render 'advent-pdp-jumps', product: product %}"
          }
        },
        "delivery_acc": {
          "type": "collapsible-content",
          "settings": {
            "heading": "Delivery & pickup",
            "icon": "none",
            "text": "<p>We ship Australia-wide with Australia Post eParcel, tracked. Games are boxed and padded; small items may go in a satchel.</p><p>In-stock games are dispatched in 1-3 business days. Games we order in from our supplier ship in 2-7 business days. Mixed orders are held and shipped together unless you ask us to split.</p>"
          }
        },
        "returns_acc": {
          "type": "collapsible-content",
          "settings": {
            "heading": "Returns & damaged games",
            "icon": "none",
            "text": "<p><strong>Change of mind:</strong> let us know in writing within 7 days of delivery. The game must be unopened and in its original packaging.</p><p><strong>Arrived damaged?</strong> Email us and we'll replace it, or give you a credit or refund.</p>"
          }
        }
      },
      "block_order": [
        "badges",
        "vendor",
        "title",
        "bgg",
        "expansion",
        "price",
        "rrp",
        "availability",
        "buy",
        "notify",
        "stats",
        "tags",
        "complementary",
        "delivery",
        "jumps",
        "delivery_acc",
        "returns_acc"
      ]
    },
    "details": {
      "type": "advent-product-details",
      "settings": {}
    },
    "videos": {
      "type": "advent-product-videos",
      "settings": {
        "heading": "Watch before you buy",
        "limit": 3
      }
    },
    "note_faq": {
      "type": "advent-note-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "When will my order ship?",
            "answer": "<p>In-stock games ship in 1-3 business days. Supplier items ship in 2-7 business days. Preorders ship within one working day of release.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I mix preorders and in-stock games in one order?",
            "answer": "<p>Yes. We hold the order and ship it together when everything has arrived, unless you ask us to split it.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do you price match?",
            "answer": "<p>[Dean to write]</p>"
          },
          "disabled": true
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Can I pick up instead?",
            "answer": "<p>Free pickup in Chatswood on Tuesday nights. Choose pickup at checkout.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ],
      "settings": {
        "logo": "shopify://shop_images/advent-logo.png",
        "note_label": "Why we like it",
        "heading": "Questions about buying from Advent"
      }
    },
    "row_addons": {
      "type": "advent-product-row",
      "settings": {
        "source": "complementary",
        "heading": "Expansions and accessories for this game",
        "subheading": "Everything that works with [title].",
        "band": true
      }
    },
    "row_series": {
      "type": "advent-product-row",
      "settings": {
        "source": "series",
        "heading": "More from the [series] series",
        "subheading": "",
        "band": false
      }
    },
    "row_system": {
      "type": "advent-product-row",
      "settings": {
        "source": "system",
        "heading": "More for [system]",
        "subheading": "Starter sets, screens, adventures and dice for the same system.",
        "band": false
      }
    },
    "row_sleeve": {
      "type": "advent-product-row",
      "settings": {
        "source": "sleeve",
        "heading": "Other sleeves in [size]",
        "subheading": "",
        "band": false
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You might also like",
        "heading_align": "text-start",
        "layout": "carousel",
        "card_size_mobile": "small",
        "card_size": "medium",
        "products_to_show": 8
      }
    },
    "story": {
      "type": "media-with-text",
      "blocks": {
        "sub": {
          "type": "subheading",
          "settings": {
            "text": "About Advent Games"
          }
        },
        "h": {
          "type": "heading",
          "settings": {
            "heading": "Your friendly, local, online board game store",
            "heading_size": "h4",
            "heading_h1": false
          }
        },
        "t": {
          "type": "text",
          "settings": {
            "text": "<p>Owner-operated in Sydney since 2012, with a huge range, fair prices and the hard-to-find games other stores don't carry. Ask about a game, a preorder or an order you've already placed and you'll hear back from Dean, not an AI response.</p><p><a href=\"/pages/about\">Our story</a> <a href=\"/pages/help\">Pickup &amp; shipping</a></p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "sub",
        "h",
        "t"
      ],
      "settings": {
        "image": "shopify://shop_images/story.jpg",
        "layout": "left",
        "image_fit": "cover",
        "media_width": 50,
        "media_scale": 100,
        "text_align": "text-start",
        "color_scheme": "2",
        "only_content_color_scheme": false
      }
    },
    "recent": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "heading_align": "text-start",
        "layout": "carousel",
        "card_size_mobile": "small",
        "card_size": "medium",
        "limit": 8
      }
    }
  },
  "order": [
    "main",
    "details",
    "videos",
    "note_faq",
    "row_addons",
    "row_series",
    "row_system",
    "row_sleeve",
    "recommendations",
    "story",
    "recent"
  ]
}