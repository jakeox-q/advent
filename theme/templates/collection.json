{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_title": true,
        "show_product_count": true,
        "show_collection_description": true,
        "text_align": "text-start",
        "text_width": "standard",
        "color_scheme": "default"
      }
    },
    "products": {
      "type": "main-collection-products",
      "settings": {
        "products_per_page": 48,
        "card_size_mobile": "small",
        "card_size": "small",
        "show_layout_toggle": true,
        "enable_filtering": true,
        "filters_open_lg": true,
        "stick_on_scroll": true,
        "show_filter_counts": true,
        "expand_filters": true,
        "max_filter_options": 7,
        "enable_sorting": true,
        "sort_show_featured": false,
        "sort_show_best": true,
        "sort_show_alpha": true,
        "sort_show_price": true,
        "sort_show_date": true,
        "sort_first": false
      },
      "blocks": {
        "promo": {
          "type": "card-promotion",
          "settings": {
            "position": 4,
            "view": "grid",
            "hide_on_filter": true,
            "color_scheme": "none",
            "image": "shopify://shop_images/euphoria-cutout.png",
            "image_ratio": "natural",
            "link_url": "shopify://collections/new-to-preorder",
            "title": "New to preorder",
            "content": "<p>This month</p>",
            "button_label": "Reserve yours",
            "button_style": "link",
            "button_bottom_align": true
          }
        }
      },
      "block_order": [
        "promo"
      ]
    },
    "seo": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% render 'advent-collection-seo', collection: collection %}",
        "section_height": "default",
        "full_width": false,
        "dividers": "none",
        "prevent_animation": true
      }
    },
    "recent": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "heading_align": "text-start",
        "layout": "carousel",
        "card_size_mobile": "small",
        "card_size": "medium",
        "limit": 8
      }
    }
  },
  "order": [
    "banner",
    "products",
    "seo",
    "recent"
  ]
}