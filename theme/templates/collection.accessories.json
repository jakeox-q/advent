{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_title": true,
        "show_product_count": true,
        "show_collection_description": true,
        "text_align": "text-start",
        "text_width": "standard",
        "color_scheme": "default"
      }
    },
    "products": {
      "type": "main-collection-products",
      "settings": {
        "products_per_page": 48,
        "card_size_mobile": "small",
        "card_size": "small",
        "show_layout_toggle": true,
        "enable_filtering": true,
        "filters_open_lg": true,
        "stick_on_scroll": true,
        "show_filter_counts": true,
        "expand_filters": true,
        "max_filter_options": 7,
        "enable_sorting": true,
        "sort_show_featured": false,
        "sort_show_best": true,
        "sort_show_alpha": true,
        "sort_show_price": true,
        "sort_show_date": true,
        "sort_first": false
      }
    },
    "recent": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "heading_align": "text-start",
        "layout": "carousel",
        "card_size_mobile": "small",
        "card_size": "medium",
        "limit": 8
      }
    }
  },
  "order": [
    "banner",
    "products",
    "recent"
  ]
}